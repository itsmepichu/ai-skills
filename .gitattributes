# Store text files with LF line endings in the repository and on checkout,
# so scripts and docs behave the same on Windows, macOS and Linux.
* text=auto eol=lf

# Binary files: never convert or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp4  binary
*.webm binary
*.zip  binary
*.woff binary
*.woff2 binary
